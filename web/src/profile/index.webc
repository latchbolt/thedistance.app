---
layout: layout.webc
title: Profile - The Distance
---

<div class="g-max-centered">
  <div class="contents">
    <header class="profile-header">
      <div class="profile-avatar"></div>
      <div class="profile-contents">
        <p class="profile-dname">&nbsp;</p>
        <p class="profile-handle">&nbsp;</p>
        <div class="profile-desc">&nbsp;</div>
      </div>
    </header>

    <div class="profile-main-content">
      <h2>Activities</h2>
      <activity-list id="profile-activities" loading profile></activity-list>
    </div>
  </div>
</div>

<style webc:scoped>
  .contents {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin: 0 auto;
    max-width: var(--grid-max-5);
    padding-bottom: 2rem;
    padding-top: 2rem;
  }

  .profile-header {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: 1rem;
    letter-spacing: -1%;
    line-height: 1.25;
  }

  .profile-main-content {
    flex: 1;
  }

  .profile-contents {
    flex: 1;
  }

  .profile-dname {
    font-size: var(--font-size-2);
    font-weight: 700;
  }

  .profile-desc {
    padding-top: 1.25rem;
  }

  .profile-avatar {
    --size: 100px;
    background: color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 20px;
    box-shadow: 0 0 1px
      color-mix(in srgb, var(--color-foreground) 20%, transparent);
    height: var(--size);
    overflow: hidden;
    width: var(--size);

    img {
      display: block;
      height: 100%;
      object-fit: cover;
      object-position: center;
      width: 100%;
    }
  }

  .load-more,
  .load-more-end {
    display: block;
    margin: 2rem auto 0 auto;
    text-align: center;
  }
</style>

<script webc:bucket="components">
  const [_, rawHandle] = window.location.pathname.split("/profile/");
  const requestedHandle = rawHandle.replaceAll("/", "");
  const handle = document.querySelector(".profile-handle");
  handle.textContent = `@${requestedHandle}`;
  document.title = `@${requestedHandle} is Going The Distance`;

  const PAGE_SIZE = 50;
  let profileDid = null;
  let profileOffset = 0;

  async function renderProfile({ user }) {
    profileDid = user.did;
    const { data } = await getActivities(user.did);
    const dname = document.querySelector(".profile-dname");
    dname.textContent = user.displayName || user.handle;

    const desc = document.querySelector(".profile-desc");
    if (user.description) {
      desc.innerHTML = user.description
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\n/g, "<br>");
    }

    if (user.avatarUrl) {
      const img = new Image();
      img.onload = () => {
        img.alt = `${user.displayName || user.handle}`;
        document.querySelector(".profile-avatar").appendChild(img);
      };
      img.src = user.avatarUrl;
    }

    const list = document.getElementById("profile-activities");
    list.handle = user.handle;
    list.activities = data;

    profileOffset = data.length;
    if (data.length >= PAGE_SIZE) {
      showLoadMore();
    }
  }

  function showLoadMore() {
    const list = document.getElementById("profile-activities");
    const existing = list.querySelector(".load-more");
    if (existing) existing.remove();

    const btn = document.createElement("button");
    btn.className = "btn-secondary load-more";
    btn.textContent = "Load more";
    btn.addEventListener("click", loadMore);
    list.appendChild(btn);
  }

  async function loadMore() {
    const btn = document.querySelector(".load-more");
    btn.disabled = true;
    btn.textContent = "Loading…";

    const { data } = await getActivities(profileDid, { offset: profileOffset });
    const list = document.getElementById("profile-activities");

    if (!data || data.length === 0) {
      btn.remove();
      list.insertAdjacentHTML(
        "beforeend",
        "<p class='load-more-end'>You went the distance.</p>"
      );
      return;
    }

    btn.remove();
    list.appendActivities(data);
    profileOffset += data.length;

    if (data.length >= PAGE_SIZE) {
      showLoadMore();
    } else {
      list.insertAdjacentHTML(
        "beforeend",
        "<p class='load-more-end'>You went the distance.</p>"
      );
    }
  }

  getUserByHandle(requestedHandle).then((foundUser) => {
    if (!foundUser) {
      document.getElementById("profile-activities").remove();
      title.textContent = `Couldn’t find @${requestedHandle}`;
      document.title = "The Distance";
      return;
    }

    renderProfile({ user: foundUser });
  });
</script>
