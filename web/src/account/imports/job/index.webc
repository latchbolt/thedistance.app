---
layout: layout.webc
title: Import - The Distance
---

<div class="g-max-centered">
  <div class="contents">
    <header>
      <header-back-btn
        href="/account/imports/"
        text="Imports"
      ></header-back-btn>
      <h2>Import</h2>
    </header>
    <div id="job-summary"></div>
    <div id="activities" class="activities">
      <div class="import-header">
        <div class="activity-header-row">
          <div>&nbsp;</div>
          <div class="activity-title">Title</div>
          <div class="activity-time">Date</div>
          <div>Moving Time</div>
          <div>Distance</div>
          <div>Elev Gain</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style webc:scoped>
  .contents {
    column-gap: var(--grid-gutter);
    display: flex;
    flex-direction: column;
    padding: 1rem 0;
    row-gap: 2rem;
  }

  .import-meta {
    align-items: center;
    display: flex;
    gap: 0.25rem;
  }

  #job-summary {
    font-size: var(--font-size-1_5);
    max-width: var(--grid-max-5);
  }

  .activities {
    --b: 1px dotted color-mix(in srgb, currentColor 20%, transparent);
    --r: 20px;
  }

  .activities ul {
    background: var(--color-background);
    border-left: var(--b);
    border-right: var(--b);
    overflow: hidden;
    padding: 0;
  }

  .import-footer {
    background-color: var(--color-background);
    bottom: 0;
    padding-bottom: 1.5rem;
    position: sticky;

    .inner {
      border-radius: 0 0 var(--r) var(--r);
      border: var(--b);
      padding: 0.75rem;
    }
  }

  .import-header {
    background-color: var(--color-background);
    position: sticky;
    padding-top: 0.5rem;
    top: 0;
  }

  [data-status="processing"],
  [data-status="failed"] {
    .import-header {
      display: none;
    }
  }

  .activity-header-row {
    border: var(--b);
    border-radius: var(--r) var(--r) 0 0;
    display: flex;
    flex: 1;
    font-size: var(--font-size-0_75);

    & > * {
      padding: 0.5rem;
      flex: 1;
      text-align: right;
    }

    & > div:first-child {
      flex: 0;
    }

    .activity-title {
      padding-left: 1.25rem;
      text-align: left;
    }
  }

  [data-status="completed"] {
    ul {
      border-bottom: var(--b);
      border-radius: 0 0 var(--r) var(--r);
      padding-bottom: 1.5rem;
    }

    .activity-header-row {
      & > div:first-child {
        display: none;
      }

      .activity-title {
        padding-left: 0.5rem;
      }
    }
  }

  .activity-row {
    border-bottom: var(--b);
    font-size: var(--font-size-0_75);
    line-height: 1;
    list-style: none;

    &:last-child:not(.completed-row) {
      border-bottom: 0;
    }

    label {
      cursor: pointer;
      display: flex;

      &:hover {
        background-color: color-mix(
          in srgb,
          var(--color-accent-foreground) 8%,
          transparent
        );
      }

      &:not(:has(input:checked)) .activity-contents > * {
        color: color-mix(in srgb, currentColor 30%, transparent);
      }
    }

    .input-container {
      border-right: var(--b);
      padding: 0.5rem;
      padding-top: 0.6rem;
    }
  }

  .activity-title,
  .activity-time {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .activity-title {
    text-align: left;
    width: 25ch;
  }

  .activity-time {
    max-width: 18ch;
  }

  .activity-contents {
    display: flex;
    flex: 1;
    text-align: right;

    & > * {
      padding: 0.5rem;
      flex: 1;
    }
  }
</style>

<script webc:bucket="components">
  const jobPathMatch = window.location.pathname.match(
    /\/account\/imports\/([^/]+)/
  );
  const jobId = jobPathMatch ? jobPathMatch[1] : null;
  const selected = new Set();
  let authedUser = null;

  if (jobId) {
    document.addEventListener("afterAuthCheck", async (e) => {
      if (!e.detail.user) {
        window.location.href = "/login";
        return;
      }

      authedUser = e.detail.user;

      const header = document.querySelector(".contents header");

      try {
        const res = await fetch(
          `${API_BASE}/api/import/jobs/${encodeURIComponent(jobId)}`,
          FETCH_OPTS
        );

        if (!res.ok) {
          header.insertAdjacentHTML("beforeend", "<p>Import not found</p>");
          return;
        }

        const job = await res.json();
        header.querySelector("h2").innerHTML = `${capitalize(
          job.source
        )} Import`;

        header.insertAdjacentHTML(
          "beforeend",
          `<div class="import-meta"><span class="job-status ${job.status}">${
            job.status
          }</span><time datetime="${job.created_at}">${formatDate(
            job.created_at
          )}</time></div>`
        );

        document.getElementById("activities").dataset.status = job.status;

        if (job.status === "processing") {
          const summary = document.getElementById("job-summary");
          summary.innerHTML = `<p>Processing ${capitalize(
            job.source
          )} import. This shouldn’t take more than 30 seconds, but if you have large archive, could take up a minute.</p>`;

          subscribeToEvents();
        } else if (job.status === "preview") {
          showManifest({
            activities: job.manifest,
            total: job.total,
            duplicates: job.duplicates,
          });
        } else if (job.status === "completed") {
          showCompleted(job);
        }
      } catch (err) {
        header.insertAdjacentHTML("beforeend", "<p>Error loading import</p>");
        console.warn(err);
      }
    });
  }

  function showManifest(manifest) {
    selected.clear();
    manifest.activities.forEach((obj, idx) => {
      if (!obj.duplicate) selected.add(idx);
    });

    const container = document.getElementById("job-summary");
    let dupesMsg = "";

    if (manifest.duplicates !== 0) {
      dupesMsg = ` Of those, ${manifest.duplicates}`;

      if (manifest.duplicates > 1) {
        dupesMsg += " look like duplicates and were deselected. ";
      } else {
        dupesMsg += " looks like a duplicate and was deselected. ";
      }
    }

    container.innerHTML = `<p><b>${manifest.total}</b> total Activities found.${dupesMsg}We’ll only import selected Activities.</p>`;

    renderActivities(manifest.activities);
  }

  function activityColumns(obj) {
    const a = obj.activity;
    const fmtDate = formatDate(a.started_at);
    const title =
      obj.rkey && authedUser
        ? `<a href="/profile/${authedUser.handle}/activity/${obj.rkey}">${a.title}</a>`
        : a.title;

    return `
      <p class="activity-title"><b>${title}</b></p>
      <time class="activity-time" datetime="${
        a.started_at
      }" title="${fmtDate}">${fmtDate}</time>
      <p>${formatDuration(a.moving_time)}</p>
      <p>${a.distance !== "0" ? `${metersToMiles(a.distance)} mi` : "-"}</p>
      <p>${
        a.elevation_gain ? `${metersToFeet(a.elevation_gain)} ft` : "-"
      }</p>`;
  }

  function renderActivities(activities) {
    const html = activities.reduce((str, obj, idx) => {
      return (
        str +
        `
        <li id="activity-${obj.activity_id}" class="activity-row">
          <label>
            <div class="input-container">
              <input type="checkbox" data-index="${idx}" name="${
          obj.activity_id
        }" ${!obj.duplicate ? "checked" : ""} />
            </div>
            <div class="activity-contents">
              ${activityColumns(obj)}
            </div>
          </label>
        </li>`
      );
    }, "");

    const container = document.getElementById("activities");
    container.querySelector(".import-header").insertAdjacentHTML(
      "afterend",
      `<ul>${html}</ul>
      <div class="import-footer">
        <div class="inner">
          <button type="button" class="btn import-btn">Import ${
            selected.size
          } ${pluralize(selected.size, "Activity", "Activities")}</button>
        </div>
      </div>`
    );

    container.querySelector("ul").addEventListener("change", (e) => {
      const checkbox = e.target;
      if (checkbox.type !== "checkbox") return;
      const idx = parseInt(checkbox.dataset.index, 10);
      if (checkbox.checked) {
        selected.add(idx);
      } else {
        selected.delete(idx);
      }
      container.querySelector(".import-btn").textContent = `Import ${
        selected.size
      } ${pluralize(selected.size, "Activity", "Activities")}`;
    });

    container
      .querySelector(".import-btn")
      .addEventListener("click", startImport);
  }

  async function startImport() {
    const container = document.getElementById("activities");
    container.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
      cb.disabled = true;
    });

    const btn = document.querySelector(".import-btn");
    btn.disabled = true;
    btn.textContent = "Importing…";

    try {
      const res = await fetch(`${API_BASE}/api/import/strava/run`, {
        ...FETCH_OPTS,
        method: "POST",
        headers: { ...FETCH_OPTS.headers, "Content-Type": "application/json" },
        body: JSON.stringify({
          job_id: jobId,
          selected: [...selected],
        }),
      });

      if (!res.ok) {
        const data = await res.json();
        btn.textContent = data.error || "Import failed";
        btn.disabled = false;
        return;
      }

      subscribeToEvents();
    } catch (err) {
      console.error(err);
      btn.textContent = "Import failed";
      btn.disabled = false;
    }
  }

  function showCompleted(job) {
    const summary = document.getElementById("job-summary");
    const parts = [`<b>${job.imported}</b> Activities imported`];
    if (job.skipped > 0) parts.push(`<b>${job.skipped}</b> skipped`);
    if (job.failed > 0) parts.push(`<b>${job.failed}</b> failed`);
    const profileLink = authedUser
      ? ` <a href="/profile/${authedUser.handle}">See them on your profile</a>.`
      : "";
    summary.innerHTML = `<p>${parts.join(", ")}.<br/>${profileLink}</p>`;

    const footer = document.querySelector(".import-footer");
    if (footer) footer.remove();

    if (job.manifest) {
      renderCompletedActivities(job.manifest.filter((obj) => obj.imported));
    }
  }

  function renderCompletedActivities(activities) {
    const html = activities.reduce((str, obj) => {
      return (
        str +
        `
        <li class="activity-row completed-row">
          <div class="activity-contents">
            ${activityColumns(obj)}
          </div>
        </li>`
      );
    }, "");

    const container = document.getElementById("activities");
    const oldList = container.querySelector("ul");
    if (oldList) oldList.remove();
    container
      .querySelector(".import-header")
      .insertAdjacentHTML("afterend", `<ul>${html}</ul>`);
  }

  function subscribeToEvents() {
    const source = new EventSource(
      `${API_BASE}/api/import/jobs/${encodeURIComponent(jobId)}/events`,
      { withCredentials: true }
    );

    source.addEventListener("status", (e) => {
      const { status } = JSON.parse(e.data);
      document.getElementById("activities").dataset.status = status;
      const el = document.querySelector(".job-status");
      if (el) {
        el.className = `job-status ${status}`;
        el.textContent = status;
      }
    });

    source.addEventListener("progress", (e) => {
      const { imported, skipped, failed, total } = JSON.parse(e.data);
      const done = imported + skipped + failed;
      const summary = document.getElementById("job-summary");
      summary.innerHTML = `<p>Importing ${done} of ${total}…</p>`;
    });

    source.addEventListener("manifest", (e) => {
      showManifest(JSON.parse(e.data));
      source.close();
    });

    source.addEventListener("completed", (e) => {
      const data = JSON.parse(e.data);
      showCompleted(data);
      source.close();
    });

    source.addEventListener("failed", (e) => {
      const { errors } = JSON.parse(e.data);
      console.error("Import failed:", errors);

      const el = document.querySelector(".job-status");
      if (el) {
        el.className = "job-status failed";
        el.textContent = "failed";
      }

      source.close();
    });

    source.addEventListener("error", () => {
      source.close();
    });
  }
</script>
