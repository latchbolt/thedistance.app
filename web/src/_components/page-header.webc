<header webc:root="override" class="g-max-centered">
  <h1>
    <a href="/">
      <img
        src="/images/logo-small-distance.svg"
        alt="Distance"
        width="113"
        height="32"
      />
      <dink-us></dink-us>
    </a>
  </h1>

  <div class="controls">
    <nav id="page-header-nav">
      <a
        :href="loginHref"
        class="nav-btn header-btn auth-btn"
        id="page-header-auth-btn"
        >Log in / Join</a
      >
    </nav>

    <scheme-chooser></scheme-chooser>
  </div>
</header>

<script webc:bucket="components">
  async function logout(e) {
    e.preventDefault();
    localStorage.removeItem("auth:user");

    const nav = document.getElementById("page-header-nav");
    nav.innerHTML = `<a :href="/" class="nav-btn auth-btn header-btn" id="page-header-auth-btn">Log in / Join</a>`;

    try {
      await fetch(`${API_BASE}/oauth/logout`, {
        ...FETCH_OPTS,
        method: "POST",
      });
    } catch {
      // Continue with local cleanup even if server call fails
    }

    window.location.href = "/";
  }

  function getAuthedUI(user) {
    return `
      <button type="button" class="nav-btn new-btn header-btn" popovertarget="page-header-new-menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24">
          <path d="M12 5l0 14" />
	        <path d="M5 12l14 0" />
        </svg>
      </button>

      <div popover id="page-header-new-menu" class="page-header-menu page-header-new-menu">
        <div class="menu-items">
          <a href="/import">
            Import
            <span class="item-desc">Migrate your data from other services.</span>
          </a>
          <a href="/upload">
            Upload
            <span class="item-desc">Create activities from common file formats.</span>
          </a>
        </div>
      </div>

      <button type="button" class="nav-btn user-btn" popovertarget="page-header-user-menu">
        <div class="user-btn-avatar">
          <img src="${user.avatarUrl}" alt="" height="24" width="24" />
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M6 9l6 6l6 -6" />
        </svg>
      </button>
      
      <div popover id="page-header-user-menu" class="page-header-menu page-header-user-menu">
        <header>
          <span class="dname">${user.displayName}</span>
          <span class="handle"><b class="at">@</b>${user.handle}</span>
        </header>
        <div class="menu-items">
          <a href="/profile/${user.handle}">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
              <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
            </svg>
            Profile
          </a>
          <a href="/account/settings">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065" />
	            <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
            </svg>
            Settings
          </a>
          <button id="logout-btn" class="logout-btn" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 8v-2a2 2 0 0 1 2 -2h7a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-7a2 2 0 0 1 -2 -2v-2" />
	            <path d="M15 12h-12l3 -3" />
	            <path d="M6 15l-3 -3" />
            </svg>
            Log out
          </button>
        </div>
      </div>`;
  }

  function onUserAvailable(user) {
    const nav = document.getElementById("page-header-nav");
    nav.innerHTML = getAuthedUI(user);

    const logoutBtn = document.getElementById("logout-btn");
    logoutBtn.addEventListener("click", logout);
  }

  document.addEventListener("afterAuthCheck", (e) => {
    const { user } = e.detail;
    if (!user) return;
    onUserAvailable(user);
  });
</script>

<style webc:scoped="page-header">
  :host {
    --padding-h: 1.5rem;
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 1rem;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: 1.2rem var(--padding-h) 1rem var(--padding-h);
  }

  @media (min-width: 500px) {
    :host {
      flex-direction: row;
    }
  }

  .controls {
    align-items: center;
    flex-shrink: 0;
    column-gap: 0.75rem;
    display: flex;
    flex-wrap: wrap;
  }

  @media (min-width: 600px) {
    :host {
      --padding-h: 3.25rem;
    }
  }

  h1 {
    a {
      display: flex;
      flex-direction: column;
      row-gap: 0.25rem;
    }

    dink-us {
      --height: 0.5rem;

      > div:not(:nth-child(3)) {
        flex: 1;
      }

      > div:nth-child(2) {
        max-width: 1.5rem;
      }
    }
  }

  nav {
    align-items: center;
    column-gap: 0.75rem;
    display: flex;
    justify-content: flex-end;
    flex: 1;

    button {
      appearance: none;
      background: none;
      cursor: pointer;
    }

    .at {
      font-weight: 600;
      opacity: 0.5;
    }

    .hidden {
      opacity: 0;
    }
  }

  .nav-btn {
    --active-border-color: light-dark(
      hsl(var(--color-foreground-hsl-light) / 25%),
      hsl(var(--color-foreground-hsl-dark) / 25%)
    );
    border: 1px dotted transparent;
    border-radius: 9999px;
    color: var(--color-foreground);
    font-size: var(--font-size-0_75);
    letter-spacing: -1%;
    padding: 0.2rem;
    text-decoration: none;

    &:hover,
    &:focus-visible {
      border-color: var(--active-border-color);
    }

    svg {
      transition: 0.15s ease;
    }
  }

  .user-btn {
    align-items: center;
    anchor-name: --user-menu-anchor;
    border-radius: 8px;
    column-gap: 0.125rem;
    display: flex;
  }

  .user-btn:has(+ .page-header-user-menu:popover-open) {
    border-color: var(--active-border-color);

    svg {
      rotate: 180deg;
    }
  }

  .user-btn-avatar {
    --size: 24px;
    background: color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 5px;
    box-shadow: 0 0 1px
      color-mix(in srgb, var(--color-foreground) 20%, transparent);
    height: var(--size);
    overflow: hidden;
    width: var(--size);

    img {
      display: block;
      height: 100%;
      object-fit: cover;
      object-position: center;
      width: 100%;
    }
  }

  .page-header-menu {
    background-color: var(--color-background);
    border: 1px dotted color-mix(in srgb, currentColor 20%, transparent);
    border-radius: 8px;
    opacity: 1;
    flex-direction: column;
    min-width: 180px;
    position-area: bottom span-left;
    top: 0.25rem;
    transform: translateY(0);
    transition: 0.15s ease;

    &:popover-open {
      display: flex;

      @starting-style {
        opacity: 0;
        transform: translateY(-1rem);
      }
    }
  }

  .page-header-user-menu {
    position-anchor: --user-menu-anchor;

    header {
      border-bottom: 1px dotted
        color-mix(in srgb, currentColor 20%, transparent);
      display: flex;
      flex-direction: column;
      letter-spacing: -1%;
      line-height: 1.1;
      padding: 0.75rem 1rem;

      .dname {
        font-size: var(--font-size-0_75);
        font-weight: 600;
      }

      .handle {
        font-size: var(--font-size-0_5);
        opacity: 0.75;
      }
    }
  }

  .menu-items {
    display: flex;
    flex-direction: column;
    font-size: var(--font-size-0_75);
    line-height: 1.1;
    padding: 0.25rem;

    button {
      appearance: none;
      background: none;
      border: 0;
      cursor: pointer;
      text-align: left;
    }

    a,
    button {
      border-radius: 5px;
      color: var(--color-foreground);
      display: flex;
      flex-wrap: wrap;
      column-gap: 0.25rem;
      row-gap: 0.1rem;
      padding: 0.5rem 0.75rem 0.5rem 0.5rem;
      text-decoration: none;

      &:has(.item-desc) {
        flex-direction: column;
      }

      &:hover,
      &:focus-visible {
        background: color-mix(in srgb, currentColor 5%, transparent);
      }

      svg {
        height: auto;
        width: 0.75rem;
      }
    }

    .item-desc {
      display: block;
      font-size: var(--font-size-0_5);
      max-width: 180px;
      opacity: 0.75;
    }

    .logout-btn {
      &:hover,
      &:focus-visible {
        color: var(--color-accent-error);
      }
    }
  }

  .header-btn {
    background: var(--color-accent-primary);
    color: hsl(var(--color-foreground-hsl-light));

    svg {
      --size: 24px;
      height: var(--size);
      width: var(--size);
    }
  }

  .new-btn:has(+ .page-header-new-menu:popover-open) {
    border-color: var(--active-border-color);

    svg {
      rotate: 45deg;
    }
  }

  .auth-btn {
    padding-left: 0.6rem;
    padding-right: 0.6rem;
  }
</style>
