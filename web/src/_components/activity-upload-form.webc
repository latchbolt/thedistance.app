<div webc:root>
  <form>
    <file-drop-zone accept=".fit,.gpx,.tcx" multiple>
      <p>Drop one or more files here or <a>Browse</a> to select.</p>
      <p>
        Accepted file types: .fit, .gpx, .tcx. You’ll get a chance to preview
        before saving.
      </p>
    </file-drop-zone>
  </form>
  <div class="activity-preview">
    <activity-list></activity-list>
  </div>
</div>

<style webc:scoped>
  :host {
    display: block;
  }

  :host.has-items {
    display: flex;
    gap: 1.3125rem;
    flex-wrap: wrap;
    flex-direction: column;

    .activity-preview {
      display: block;
      flex: 1;
    }
  }

  @media (min-width: 940px) {
    :host.has-items {
      flex-direction: row;
    }
  }

  .activity-preview {
    display: none;
  }

  form {
    flex: 1;
  }

  .btn {
    align-items: center;
    appearance: none;
    background-color: var(--color-accent-primary);
    border: 0;
    border-radius: 16px;
    color: hsl(var(--color-foreground-hsl-light));
    cursor: pointer;
    display: grid;
    justify-content: center;
    line-height: 1;
    padding: 0.65rem 0.5rem;
    font-family: var(--font-display);
    font-size: var(--font-size-2);
    text-box-trim: trim-end;
    text-transform: uppercase;
    width: 100%;

    > * {
      grid-area: 1 / 1;
    }

    dink-us {
      --height: 0.7rem;
      --bg-color: currentColor;
      margin-top: 0.25rem;
      pointer-events: none;
      min-width: 80px;

      & > div:not(:nth-child(3)) {
        flex: 1;
      }

      & > div:nth-child(2) {
        max-width: 1.2rem;
      }
    }

    .hidden {
      opacity: 0;
    }
  }

  activity-list + .btn {
    margin-top: 1rem;
  }

  .btn + activity-list {
    margin-top: 1rem;
  }
</style>

<script webc:bucket="components">
  class ActivityUploadForm extends HTMLElement {
    connectedCallback() {
      this.user = null;
      this.parsedActivities = [];

      document.addEventListener("afterAuthCheck", (e) => {
        const { user } = e.detail;

        if (!user) {
          this.dropZone.showError(
            "<a href=’/login’>Log in</a> to upload Activities",
          );
          return;
        }

        this.user = user;
        this.dropZone.enable();
      });

      this.addEventListener("files-selected", (e) => {
        this.handleUpload(e.detail.files);
      });
    }

    get dropZone() {
      return this.querySelector("file-drop-zone");
    }

    get activityList() {
      return this.querySelector("activity-list");
    }

    async handleUpload(files) {
      this.dropZone.clearMessages();
      this.dropZone.showStatus("🎶 He’s going for speed…");

      const formData = new FormData();
      for (const file of files) {
        formData.append("files", file);
      }

      try {
        const res = await fetch(`${API_BASE}/api/parse`, {
          ...FETCH_OPTS,
          method: "POST",
          body: formData,
        });

        if (!res.ok) {
          const err = await res.json();
          this.dropZone.showError(err.error || "Upload failed");
          this.dropZone.clearMessages();
          return;
        }

        const data = await res.json();
        const activities = data.activities;

        if (activities.length === 0) {
          this.dropZone.clearMessages();
          this.dropZone.showError("No activities found in uploaded files");
          return;
        }

        this.parsedActivities = activities;
        this.dropZone.clearMessages();
        this.showPreview(activities);
      } catch (err) {
        this.dropZone.showError(err.message);
        this.dropZone.clearMessages();
      }
    }

    showPreview(activities) {
      this.classList.add("has-items");

      const list = this.activityList;
      list.handle = this.user.handle;
      list.activities = activities;

      const hasBtns = this.querySelector(".save-btn");

      if (!hasBtns) {
        const btn = `
        <button type="button" class="btn save-btn">
          <div class="temp-dinkus hidden">•••</div>
          <span>Save ${activities.length > 1 ? "Activities" : "Activity"}</span>
        </button>
      `;

        list.insertAdjacentHTML("beforebegin", btn);
        list.insertAdjacentHTML("afterend", btn);

        this.querySelectorAll(".save-btn").forEach((el) => {
          el.addEventListener("click", () => this.handleCreate());
        });
      }
    }

    setSaveButtonsLoading(loading) {
      this.querySelectorAll(".save-btn").forEach((btn) => {
        btn.disabled = loading;
        btn.querySelector("span").classList.toggle("hidden", loading);
        // FIXME: Make dinkus a native component so we don't have to do this.
        btn.querySelector(".temp-dinkus").classList.toggle("hidden", !loading);
      });
    }

    async handleCreate() {
      this.setSaveButtonsLoading(true);
      this.dropZone.clearMessages();

      const errors = [];
      const created = [];

      for (const activity of this.parsedActivities) {
        try {
          const res = await fetch(`${API_BASE}/api/activities`, {
            ...FETCH_OPTS,
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(activity),
          });

          if (!res.ok) {
            try {
              const err = await res.json();
              errors.push(err.error || "Save failed");
            } catch {
              errors.push(`Save failed (HTTP ${res.status})`);
            }
          } else {
            const data = await res.json();
            created.push(data);
          }
        } catch (err) {
          errors.push(err.message);
        }
      }

      if (errors.length > 0) {
        const errMsg = errors.map((e) => `${e}<br/>`).join("");
        this.dropZone.showError(errMsg);
        this.setSaveButtonsLoading(false);
        return;
      }

      if (created.length === 1) {
        const { rkey } = created[0];
        window.location.href = `/profile/${this.user.handle}/activity/${rkey}`;
      } else {
        window.location.href = `/profile/${this.user.handle}`;
      }
    }
  }

  customElements.define("activity-upload-form", ActivityUploadForm);
</script>
