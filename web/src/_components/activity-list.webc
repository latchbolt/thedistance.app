<div class="preview">
  <div></div>
  <div></div>
</div>

<script webc:bucket="components">
  class ActivityList extends HTMLElement {
    connectedCallback() {
      document.addEventListener("afterAuthCheck", (e) => {
        const { user } = e.detail;
        this.viewerDid = user?.did || null;
      });
    }

    get loading() {
      return this.hasAttribute("loading");
    }

    set loading(value) {
      if (value) {
        this.setAttribute("loading", "");
      } else {
        this.removeAttribute("loading");
      }
    }

    get profile() {
      return this.hasAttribute("profile");
    }

    set profile(value) {
      if (value) {
        this.setAttribute("profile", "");
      } else {
        this.removeAttribute("profile");
      }
    }

    set activities(data) {
      this.loading = false;
      this.querySelector(".preview").classList.add("hidden");

      if (data.length === 0) {
        this.insertAdjacentHTML(
          "beforeend",
          "<p class='zero'>No Activities yet</p>"
        );
        return;
      }

      if (!this.polylines) this.polylines = new Map();
      for (const activity of data) {
        if (activity.polyline && activity.rkey) {
          this.polylines.set(activity.rkey, activity.polyline);
        }
      }

      this.querySelector("ul")?.remove();
      this.insertAdjacentHTML(
        "beforeend",
        `<ul>${this.renderItems(data)}</ul>`
      );
      this.initMaps();
    }

    appendActivities(data) {
      if (data.length === 0) return;

      if (!this.polylines) this.polylines = new Map();
      for (const activity of data) {
        if (activity.polyline && activity.rkey) {
          this.polylines.set(activity.rkey, activity.polyline);
        }
      }

      const ul = this.querySelector("ul");
      if (ul) {
        ul.insertAdjacentHTML("beforeend", this.renderItems(data));
        this.initMaps();
      }
    }

    renderItems(data) {
      return data
        .map((activity) => {
          const stats = getActivityStats(activity).slice(0, 3);

          const ownerId = activity.owner_handle || activity.did;
          const ownerURL = `/profile/${ownerId}`;

          const activityURL = !activity.rkey
            ? "#"
            : `/profile/${ownerId}/activity/${activity.rkey}`;

          const activityTitle = activity.title;

          return `<li>
            <div class="activity" id="activity-${activity.rkey}">
              <header class="activity-header">
                ${
                  activity.did && !this.profile
                    ? `
                  <a href="${ownerURL}" class="avatar">
                    ${
                      activity.owner_avatar_url
                        ? `<img src="${activity.owner_avatar_url}" alt="" />`
                        : ""
                    }
                  </a>`
                    : ""
                }

                <div class="details">
                  <div class="byline">
                    ${
                      activity.did && !this.profile
                        ? `
                    <a href="${ownerURL}">${this.getOwnerFullDisplayName(
                            activity
                          )}
                    </a> • `
                        : ""
                    }
                    <time datetime="${activity.started_at}">
                      <a href=${activityURL}>${formatDate(
            activity.started_at
          )}</a>
                    </time>
                  </div>
                  <a href=${activityURL} class="title">${activityTitle}</a>

                  ${
                    activity.description
                      ? `<p class="desc">${activity.description}</p>`
                      : ""
                  }

                  <div class="activity-stats">
                    ${stats
                      .map((s) => {
                        return `
                          <div>
                            <div class="stat-label">${s.label}</div>
                            <div class="stat-value">${s.value}</div>
                          </div>`;
                      })
                      .join("")}
                  </div>
                </div>
              </header>
              ${
                activity.polyline
                  ? `
                  <a href="${activityURL}"><div class="activity-map" data-rkey="${
                      activity.rkey
                    }">${polylineToSVG(activity.polyline)}</div></a>
                `
                  : ""
              }
            </div>
          </li>`;
        })
        .join("");
    }

    getOwnerFullDisplayName(activity) {
      if (activity.owner_display_name && activity.owner_handle) {
        return `<b>${activity.owner_display_name}</b> @${activity.owner_handle}`;
      }
      if (activity.owner_display_name) return activity.owner_display_name;
      if (activity.owner_handle) return `@${activity.owner_handle}`;
      return activity.did;
    }

    viewerIsOwner(activity) {
      return this.viewerDid && activity.did === this.viewerDid;
    }

    initMaps() {
      const polylines = this.polylines;
      const MAX_CONCURRENT = 3;
      const queue = [];
      let active = 0;

      function processQueue() {
        while (active < MAX_CONCURRENT && queue.length > 0) {
          const el = queue.shift();
          if (el.dataset.captured) continue;
          active++;
          renderMap(el).then(() => {
            active--;
            processQueue();
          });
        }
      }

      function renderMap(el) {
        return new Promise((resolve) => {
          const encoded = polylines.get(el.dataset.rkey);
          if (!encoded) {
            resolve();
            return;
          }
          const coords = decodePolyline(encoded);
          if (coords.length < 2) {
            resolve();
            return;
          }

          const bounds = coords.reduce(
            (b, coord) => b.extend(coord),
            new maplibregl.LngLatBounds(coords[0], coords[0])
          );

          const map = new maplibregl.Map({
            container: el,
            style: "https://tiles.openfreemap.org/styles/positron",
            bounds: bounds,
            fitBoundsOptions: { padding: 40 },
            interactive: false,
            attributionControl: false,
          });

          map.on("load", () => {
            map.addSource("route", {
              type: "geojson",
              data: {
                type: "Feature",
                geometry: { type: "LineString", coordinates: coords },
              },
            });

            map.addLayer({
              id: "route",
              type: "line",
              source: "route",
              paint: { "line-color": "#FFE866", "line-width": 4 },
            });

            map.once("idle", () => {
              const img = new Image();
              img.src = map.getCanvas().toDataURL();
              img.style.cssText =
                "width:100%;height:100%;object-fit:cover;display:block;";
              map.remove();
              el.innerHTML = "";
              el.appendChild(img);
              el.dataset.captured = "true";
              resolve();
            });
          });
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !entry.target.dataset.captured) {
              queue.push(entry.target);
              observer.unobserve(entry.target);
            }
          }
          processQueue();
        },
        { rootMargin: "200px" }
      );

      this.querySelectorAll(".activity-map[data-rkey]").forEach((el) => {
        observer.observe(el);
      });
    }
  }

  customElements.define("activity-list", ActivityList);

  /*
FIXME: Re implement delete

  const deleteBtn = showDelete
    ? `<form class="delete-form" data-did="${activity.did}" data-rkey="${activity.rkey}">
        <button type="submit" class="delete-btn">Delete</button>
      </form>`
    : "";
}

async function handleDelete(e) {
  e.preventDefault();
  const form = e.target;
  const did = form.dataset.did;
  const rkey = form.dataset.rkey;
  const btn = form.querySelector("button");

  if (!confirm("Delete this activity?")) return;

  btn.disabled = true;
  btn.textContent = "Deleting\u2026";

  try {
    const res = await fetch(`${API_BASE}/api/activities/${did}/${rkey}`, {
      ...FETCH_OPTS,
      method: "DELETE",
    });

    if (!res.ok) {
      const err = await res.json();
      alert(err.error || "Delete failed");
      btn.disabled = false;
      btn.textContent = "Delete";
      return;
    }

    const article = document.getElementById(`activity-${rkey}`);
    if (article) article.remove();
  } catch (err) {
    alert("Delete failed: " + err.message);
    btn.disabled = false;
    btn.textContent = "Delete";
  }
}
  */
</script>

<style webc:scoped>
  :host {
    display: block;
  }

  :host.tiled {
    ul {
      --min-width: 220px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(var(--min-width), 1fr));
      column-gap: var(--grid-gutter);
      row-gap: 1.25rem;
    }

    li {
      display: flex;
      flex-direction: column;
    }
  }

  @media (min-width: 480px) {
    :host.tiled ul {
      --min-width: 350px;
    }
  }

  .preview {
    display: flex;
    flex-direction: column;
    row-gap: 1.25rem;

    &.hidden {
      display: none;
      visibility: hidden;
    }

    > div {
      background: color-mix(in srgb, var(--color-foreground) 2%, transparent);
      border: 1px dotted color-mix(in srgb, currentColor 20%, transparent);
      border-radius: 20px;
      height: 432px;
      overflow: hidden;
      width: 100%;

      &::before {
        background: var(--color-background);
        border-radius: 16px 16px 0 0;
        content: "";
        display: block;
        height: 31%;
        width: 100%;
      }
    }
  }

  .zero {
    font-weight: 500;
    padding: 3rem 0.5rem;
    text-align: center;
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    column-gap: var(--grid-gutter);
    row-gap: 1.25rem;
  }

  .activity {
    background: var(--color-background);
    border: 1px dotted color-mix(in srgb, currentColor 20%, transparent);
    border-radius: 20px;
    display: flex;
    flex: 1;
    flex-direction: column;
    overflow: hidden;
  }

  .activity-header {
    flex: 1;
    display: flex;
    gap: 0.75rem;
    padding: 1rem;
  }

  .byline {
    align-items: center;
    display: flex;
    font-size: var(--font-size-0_75);
    gap: 0.25rem;
    line-height: 1.2;
    max-width: 100%;
    overflow: hidden;
    padding-bottom: 0.1rem;

    a {
      color: var(--color-foreground);
      overflow: hidden;
      text-decoration: none;
      text-overflow: ellipsis;
      white-space: nowrap;

      &:hover,
      &:focus-visible {
        text-decoration: underline;
      }
    }

    b {
      font-weight: 700;
    }

    time {
      flex-shrink: 0;
    }
  }

  .details {
    flex: 1;
    overflow: hidden;

    .title {
      font-weight: 500;
      font-size: var(--font-size-1_5);
    }

    a[href="#"] {
      color: var(--color-foreground);
      text-decoration: none;
      pointer-events: none;
    }
  }

  .activity-stats {
    display: flex;
    flex-wrap: wrap;
    padding-top: 1rem;
    column-gap: 0.75rem;
    row-gap: 1rem;

    > div {
      min-width: 10ch;
    }

    .stat-label {
      font-size: var(--font-size-0_75);
      line-height: 0.9;
    }

    .stat-value {
      font-size: var(--font-size-1_5);
      font-weight: 600;
      line-height: 1.1;
    }
  }

  .avatar {
    --size: 50px;
    background: color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 10px;
    box-shadow: 0 0 1px
      color-mix(in srgb, var(--color-foreground) 20%, transparent);
    display: block;
    flex-shrink: 0;
    height: var(--size);
    overflow: hidden;
    width: var(--size);

    img {
      display: block;
      height: 100%;
      object-fit: cover;
      object-position: center;
      width: 100%;
    }
  }

  .activity-map {
    background: color-mix(in srgb, var(--color-foreground) 2%, transparent);
    color: var(--color-accent-primary);
    height: 300px;
  }
</style>
